rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    // ============= users =============
    match /users/{userId} {
      // ה-owner יכולה לקרוא הכל, משתמש קורא רק את עצמו
      allow read: if isSignedIn() && (isOwner() || request.auth.uid == userId);

      // המשתמש יוצר את עצמו
      allow create: if isSignedIn() && request.auth.uid == userId;

      // המשתמש מעדכן את עצמו, owner יכולה לעדכן כל אחד
      allow update: if isSignedIn() && (isOwner() || request.auth.uid == userId);

      // owner יכולה למחוק כל אחד (והמשתמש יכול למחוק את עצמו אם תרצי)
      allow delete: if isSignedIn() && (isOwner() || request.auth.uid == userId);
    }

    // ============= users history =============
    match /users/{userId}/history/{historyId} {
      allow read, write: if isSignedIn() && (isOwner() || request.auth.uid == userId);
    }

    // ============= appointments =============
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();

      // יצירה: owner תמיד, customer רק לעצמו
      allow create: if isSignedIn()
        && (isOwner() || request.resource.data.userId == request.auth.uid);

      // עדכון: owner תמיד, customer רק לעצמו (אפשר לצמצם אם בא לך)
      allow update: if isSignedIn()
        && (isOwner() || resource.data.userId == request.auth.uid);

      // מחיקה: owner תמיד, customer רק לעצמו
      allow delete: if isSignedIn()
        && (isOwner() || resource.data.userId == request.auth.uid);
    }

    // ============= userReservations =============
    match /userReservations/{uid} {
      allow read: if isSignedIn() && (isOwner() || request.auth.uid == uid);

      // owner יכולה ליצור/לעדכן/למחוק לכל אחד
      // customer רק לעצמו
      allow create, update, delete: if isSignedIn()
        && (isOwner() || request.auth.uid == uid);
    }

    // ============= appointmentRequests =============
    match /appointmentRequests/{requestId} {
      allow read: if isSignedIn()
        && (isOwner() || request.auth.uid == resource.data.userId);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;

      // owner יכולה לעדכן/למחוק הכל
      // customer רק את שלו
      allow update, delete: if isSignedIn()
        && (isOwner() || request.auth.uid == resource.data.userId);
    }

    // ============= settings =============
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isOwner();
    }

    // ============= availability =============
    match /availability/{dateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner();
    }

    // ============= business =============
    match /business/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && isOwner();
    }

    // ============= reviews =============
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();

      allow update, delete: if isSignedIn()
        && (isOwner() || request.auth.uid == resource.data.userId);
    }

    // ============= waitlists =============
    // 🔥 כאן היה לך פתוח לכולם read,write — זה לא טוב
    // וגם היה יכול לעשות בעיות בניקוי/הולד
    match /waitlists/{waitlistId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isOwner();
      // אם את רוצה שגם customer יוכל "להירשם לרשימת המתנה" בעצמו,
      // תגידי לי ואוסיף כלל מוגבל שמאפשר לו רק להוסיף את עצמו בלי למחוק/לדרוס אחרים.
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}